---
ENVIRONMENT
  Name:  claude-proj
  File:  <proj>/sbxenv.yaml

SANDBOX
  + claude-proj
      agent: claude
      sandboxOptions.cpus: 2
      sandboxOptions.memory: 4g

ENV
  + X
      value: one

SECRETS
  + github
      command: printf tok
      workdir: fresh host temporary directory

PORTS
  + 80/tcp
      host: 8080

  4 to add · 0 to change · 0 to destroy
  ! this plan runs commands on this machine, outside the sandbox, with your own privileges
  ✓ approved as it stands — applying asks again for the commands it declares here
