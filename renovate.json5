{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:best-practices'],
  'pre-commit': {
    enabled: true,
  },
  customManagers: [
    {
      // the smolvm version CI installs (e2e and the nix kit check)
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/actions/smolvm/action\\.yaml$/'],
      matchStrings: ['SMOLVM_VERSION: "(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'smol-machines/smolvm',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // the kit builder's image: sbx's shell kit, pinned by digest
      customType: 'regex',
      managerFilePatterns: ['/^src/provision/builder\\.rs$/'],
      matchStrings: [
        '"(?<depName>docker\\.io/sbx/shell):(?<currentValue>latest)@(?<currentDigest>sha256:[a-f0-9]+)"',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // cross-compile image used by `just release-build`
      customType: 'regex',
      managerFilePatterns: ['/^justfile$/'],
      matchStrings: [
        '(?<depName>ghcr\\.io/rust-cross/cargo-zigbuild):(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchPackageNames: ['*'],
      minimumReleaseAge: '7 days',
    },
  ],
}
