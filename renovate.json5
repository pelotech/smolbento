{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:best-practices'],
  'pre-commit': {
    enabled: true,
  },
  customManagers: [
    {
      // smolvm installed by the e2e workflow
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/e2e\\.yaml$/'],
      matchStrings: ['SMOLVM_VERSION: "(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'smol-machines/smolvm',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // pinned agent and kit builder template images; tags look like claude-code-docker-0.10.0
      customType: 'regex',
      managerFilePatterns: ['/^src/agents\\.rs$/', '/^src/kits/builder\\.rs$/'],
      matchStrings: ['"(?<depName>docker/sandbox-templates):(?<currentValue>[a-z0-9.-]+)"'],
      datasourceTemplate: 'docker',
      versioningTemplate: 'regex:^(?<compatibility>[a-z-]+)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      // cross-compile image used by `just release-build`
      customType: 'regex',
      managerFilePatterns: ['/^justfile$/'],
      matchStrings: ['(?<depName>ghcr\\.io/rust-cross/cargo-zigbuild):(?<currentValue>[0-9.]+)'],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchPackageNames: ['*'],
      minimumReleaseAge: '7 days',
    },
  ],
}
